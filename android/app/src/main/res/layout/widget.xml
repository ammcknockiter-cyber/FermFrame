<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="FermFrame" android:textColor="#FFFFCC33" android:textSize="13sp" android:textStyle="bold" />

    <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_name1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFE8E8E8" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_sub1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FF969696" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/w_sg1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFCC33" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_temp1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FF5BBEFF" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_name2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFE8E8E8" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_sub2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FF969696" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/w_sg2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFCC33" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_temp2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FF5BBEFF" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/w_when" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FF6E6E6E" android:textSize="10sp" />
</LinearLayout>
